#!/usr/bin/env bash

set -euo pipefail

if [ "$#" -ne 2 ]; then
    echo "Usage: $0 <backup-file> <target-database>"
    exit 1
fi

backup_file="$1"
target_database="$2"

source /etc/raitbyne-inventory.env

if [ "${target_database}" = "${DB_NAME}" ]; then
    echo "Refusing to restore over the live database: ${DB_NAME}"
    exit 1
fi

if [ ! -f "${backup_file}" ]; then
    echo "Backup file not found: ${backup_file}"
    exit 1
fi

export PGPASSWORD="${DB_PASSWORD}"
trap 'unset PGPASSWORD' EXIT

pg_restore \
  --host="${DB_HOST}" \
  --port="${DB_PORT}" \
  --username="${DB_USER}" \
  --dbname="${target_database}" \
  --clean \
  --if-exists \
  --no-owner \
  --no-privileges \
  "${backup_file}"

echo "Restore completed into: ${target_database}"
