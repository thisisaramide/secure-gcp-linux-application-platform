#!/usr/bin/env bash

set -euo pipefail

source /etc/raitbyne-inventory.env

backup_directory="/var/backups/raitbyne-inventory"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
backup_file="${backup_directory}/${DB_NAME}-${timestamp}.dump"

install -d -m 700 "${backup_directory}"

export PGPASSWORD="${DB_PASSWORD}"
trap 'unset PGPASSWORD' EXIT

pg_dump \
  --host="${DB_HOST}" \
  --port="${DB_PORT}" \
  --username="${DB_USER}" \
  --format=custom \
  --file="${backup_file}" \
  "${DB_NAME}"

find "${backup_directory}" -type f -name "*.dump" -mtime +7 -delete

echo "Backup created: ${backup_file}"
